PROJECT_NAME="Dheeksha Insurance API"
VERSION="1.0.0"

# CORS: Replace with your actual frontend URL when deploying
FRONTEND_URL="http://localhost:5173"

# MariaDB / MySQL (Async connection using asyncmy for target relational database)
DATABASE_URL="mysql+asyncmy://<username>:<password>@localhost:3306/dheeksha_insurance"

# JWT: Generate a secure random secret of at least 32 characters for production
SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin credentials: Replace with your own secure production credentials
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"

# Gmail SMTP Configuration (Enquiry notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_EMAIL="your-gmail-address@gmail.com"
SMTP_APP_PASSWORD="your-google-app-password"
ENQUIRY_NOTIFICATION_EMAIL="neelkanthbpvi@gmail.com"